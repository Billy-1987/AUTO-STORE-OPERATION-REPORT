-- 门店×品牌级指标（双期间 UNION，用于 TOP20 品牌 + 同店同比）
-- 字段：period_tag, shop_id, brand_id, brand_name, orders, qty, sales_yuan
SELECT 'curr' AS period_tag,
       ol.shop_id, ol.brand_id, ol.brand_name,
       COUNT(DISTINCT ol.parent_serial_no) AS orders,
       COUNT(*)                            AS qty,
       SUM(ol.fact_pay_amt)/100            AS sales_yuan
FROM bigoffs_sync.b_order_list ol
WHERE ol.pay_time >= '{{ period_start_str }} 00:00:00'
  AND ol.pay_time <  '{{ period_end_next_day_str }} 00:00:00'
  AND ol.shop_id != 3018
  AND ol.brand_id > 0
  AND ol.o_status IN (7, 8)
GROUP BY ol.shop_id, ol.brand_id, ol.brand_name

UNION ALL

SELECT 'yoy',
       ol.shop_id, ol.brand_id, ol.brand_name,
       COUNT(DISTINCT ol.parent_serial_no),
       COUNT(*),
       SUM(ol.fact_pay_amt)/100
FROM bigoffs_sync.b_order_list ol
WHERE ol.pay_time >= '{{ yoy_start_str }} 00:00:00'
  AND ol.pay_time <  '{{ yoy_end_next_day_str }} 00:00:00'
  AND ol.shop_id != 3018
  AND ol.brand_id > 0
  AND ol.o_status IN (7, 8)
GROUP BY ol.shop_id, ol.brand_id, ol.brand_name;
