# 文件作用：后端环境变量模板（提交到 git，真实值见 .env）
# 版本：v0.1.0 — 初始化

# ===== AI 网关 (ModelVerse) =====
AI_BASE_URL=https://api.modelverse.cn/v1
AI_API_KEY=
AI_DEFAULT_MODEL=claude-sonnet-4-6

# ===== 业务只读库 (Doris) =====
DORIS_RO_HOST=aidoris.bigoffs.com.cn
DORIS_RO_PORT=49030
DORIS_RO_USER=bigoffs_readonly
DORIS_RO_PASSWORD=
DORIS_RO_DB=bigoffs_sync

# ===== 项目自用写库 (Doris) =====
DORIS_RW_HOST=
# DORIS_RW_PORT=
DORIS_RW_USER=
DORIS_RW_PASSWORD=
DORIS_RW_DB=

# ===== 钉钉企业内部应用（工作通知）=====
# 钉钉开放平台 → 应用开发 → 企业内部应用 → 凭证与基础信息
# 应用需开"消息通知"权限，IP 白名单加后端服务器出口 IP
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=

# ===== 应用配置 =====
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
